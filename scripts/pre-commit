#!/bin/bash

# Pre-commit hook for Enter-Comm
# Runs code quality checks before allowing commits

set -e

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get the list of staged Kotlin files
STAGED_KOTLIN_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.kt$|\.kts$' || true)

if [ -z "$STAGED_KOTLIN_FILES" ]; then
    echo -e "${GREEN}No Kotlin files staged, skipping checks.${NC}"
    exit 0
fi

echo -e "${YELLOW}Checking staged Kotlin files...${NC}"

# Run Spotless check on staged files
echo "Running Spotless format check..."
if ! ./gradlew spotlessCheck --daemon -q 2>/dev/null; then
    echo -e "${RED}Spotless check failed!${NC}"
    echo -e "${YELLOW}Run './gradlew spotlessApply' to fix formatting issues.${NC}"
    exit 1
fi
echo -e "${GREEN}Spotless check passed.${NC}"

# Run Detekt on staged files
echo "Running Detekt static analysis..."
if ! ./gradlew detekt --daemon -q 2>/dev/null; then
    echo -e "${RED}Detekt check failed!${NC}"
    echo -e "${YELLOW}Please fix the issues reported above.${NC}"
    exit 1
fi
echo -e "${GREEN}Detekt check passed.${NC}"

# Run lint check (quick mode)
echo "Running Android Lint..."
if ! ./gradlew lintDebug --daemon -q 2>/dev/null; then
    echo -e "${YELLOW}Lint warnings found. Review before pushing.${NC}"
    # Note: Not blocking commit on lint warnings, just inform
fi
echo -e "${GREEN}Lint check completed.${NC}"

echo -e "${GREEN}All pre-commit checks passed!${NC}"
exit 0
